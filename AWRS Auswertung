AWRS was shorten in the final version from an 18-item pool to 14-items. The numbering of the items follow the old 18-items version. 
The categorization of the items: 
 - Factor 1: inner tension/exhaustion -> 2,10,11,12,13,15,16 
 - Factor 2: daytime AWR impairement -> 8, 9, 14 
 - Factor 3: nocturnal AWR impairement -> 5,4,1,3 

# ---- Define item groups ----

# All WRSS items
wrss_items <- paste0("wrss_", sprintf("%02d", 1:16))

# Subscales
IT_items   <- paste0("wrss_", sprintf("%02d", c(2,10,11,12,13,15,16)))  # Inner tension/exhaustion
DAWR_items <- paste0("wrss_", sprintf("%02d", c(8,9,14)))               # Daytime AWR impairment
NAWR_items <- paste0("wrss_", sprintf("%02d", c(5,4,1,3)))              # Nocturnal AWR impairment

# ---- Calculate sum scores ----

wrss0526$wrss_total <- rowSums(wrss0526[, wrss_items], na.rm = TRUE)

wrss0526$IT   <- rowSums(wrss0526[, IT_items], na.rm = TRUE)
wrss0526$DAWR <- rowSums(wrss0526[, DAWR_items], na.rm = TRUE)
wrss0526$NAWR <- rowSums(wrss0526[, NAWR_items], na.rm = TRUE)

library(dplyr)

wrss_diff <- wrss0526 %>%
  
  # Keep only baseline and follow-up
  filter(studyeventoid %in% c("e.mzp1_selbst", "e.mzp7_selbst")) %>%
  
  group_by(supplementalid) %>%
  summarize(
    # Baseline
    wrss_baseline = wrss_total[studyeventoid == "e.mzp1_selbst"][1],
    
    # Follow-up
    wrss_followup = wrss_total[studyeventoid == "e.mzp7_selbst"][1],
    
    .groups = "drop"
  ) %>%
  
  mutate(
    wrss_diff = wrss_followup - wrss_baseline,
    missing_baseline = is.na(wrss_baseline),
    missing_followup = is.na(wrss_followup),
    two_points_available = !(missing_baseline | missing_followup)
  )
