library(dplyr)
library(stringr)
library(lubridate)

med_yn926 <- med_yn926 %>%
  mutate(
    # IDs & keys
    supplementalid      = str_trim(as.character(supplementalid)),
    studyeventoid       = str_trim(as.character(studyeventoid)),
    studyeventrepeatkey = str_trim(as.character(studyeventrepeatkey)),
    formoid             = str_trim(as.character(formoid)),
    formrepeatkey       = str_trim(as.character(formrepeatkey)),
    itemgroupoid        = str_trim(as.character(itemgroupoid)),
    itemgrouprepeatkey  = str_trim(as.character(itemgrouprepeatkey)),
    itemgrouppk         = str_trim(as.character(itemgrouppk)),
    subjectkey          = str_trim(as.character(subjectkey)),

    # Dates
    md_dt     = as_date(md_dt),
    arc_md_dt = as_date(arc_md_dt),

    # Yes / No medication flag
    md_yn = case_when(
      toupper(str_trim(as.character(md_yn))) %in% c("Y", "YES", "1") ~ "Y",
      toupper(str_trim(as.character(md_yn))) %in% c("N", "NO", "0")  ~ "N",
      TRUE ~ NA_character_
    )
  )


