+     filter(studyeventoid == "e.mzp1") %>%
+     group_by(supplementalid) %>%
+     summarise(
+         eligible =
+             all(is.na(med_name)) |
+             !any(med_name %in% AD_SM, na.rm = TRUE),
+         .groups = "drop"
+     ) %>%
+     filter(eligible) %>%
+     pull(supplementalid)

