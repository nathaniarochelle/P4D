4. Decide eligibility at baseline only + Apply eligibility to full dataset
incl_analysis926 <- med_comb926 %>%
  inner_join(
    med_comb926 %>%
      filter(studyeventoid == "e.mzp1") %>%
      group_by(supplementalid) %>%
      summarise(
        eligible = all(is.na(med_name)) |
          !any(med_name %in% AD_SM_PS, na.rm = TRUE),
        .groups = "drop"
      ) %>%
      filter(eligible) %>%
      select(supplementalid),
    by = "supplementalid"
  )

