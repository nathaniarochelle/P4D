1. Import and clean 
medrep <- medrep_ent %>% 
+     mutate(
+         # IDs as character
+         supplementalid       = as.character(supplementalid),
+         studyeventoid        = as.character(studyeventoid),
+         studyeventrepeatkey  = as.character(studyeventrepeatkey),
+         formoid              = as.character(formoid),
+         formrepeatkey        = as.character(formrepeatkey),
+         itemgroupoid         = as.character(itemgroupoid),
+         itemgrouprepeatkey   = as.character(itemgrouprepeatkey),
+         itemgrouppk          = as.character(itemgrouppk),
+         subjectkey           = as.character(subjectkey),
+         
+         # Medication name: trim spaces
+         md_name              = str_squish(md_name),
+         
+         # Dose and units: numeric where possible
+         md_dose              = as.numeric(md_dose),
+         arc_md_dose          = as.numeric(arc_md_dose),
+         md_unit              = str_squish(md_unit),
+         arc_md_unit          = str_squish(arc_md_unit),
+         
+         # Application and frequency: trim spaces
+         md_appli             = str_squish(md_appli),
+         md_daily             = as.numeric(md_daily),
+         md_inter             = as.numeric(md_inter),
+         arc_md_inter         = as.numeric(arc_md_inter),
+         
+         # TDM values: numeric
+         md_tdmw              = as.numeric(md_tdmw),
+         mu_md_tdmw           = str_squish(mu_md_tdmw),
+         arc_md_tdmw          = as.numeric(arc_md_tdmw),
+         
+         md_tdmm              = as.numeric(md_tdmm),
+         mu_md_tdmm           = str_squish(mu_md_tdmm),
+         arc_md_tdmm          = as.numeric(arc_md_tdmm),
+         
+         md_tdmsu             = as.numeric(md_tdmsu),
+         mu_md_tdmsu          = str_squish(mu_md_tdmsu),
+         arc_md_tdmsu         = as.numeric(arc_md_tdmsu),
+         
+         md_tdmb              = as.numeric(md_tdmb)
+     )

decode <- med_decode %>%
+     
+     transmute(
+         med_code = str_squish(str_to_upper(as.character(`Codelist Item Value`))),
+         med_name = str_squish(as.character(`Codelist Item (Medikamentenname)`))
+     ) %>%
+     filter(!is.na(med_code) & med_code != "") %>%
+     distinct(med_code, .keep_all = TRUE)

2. Merge + Decode 
patcoded <- medrep %>%
+     left_join(decode, by = c("md_name" = "med_code"))

3. Medication classification
antidep_names <- c("Agomelatin","Amitriptylin","Bupropion","Citalopram","Clomipramin",
+     "Desvenlafaxin","Doxepin","Duloxetin","Escitalopram","Esketamin",
+     "Fluoxetin","Fluvoxamin","Johanniskraut","Milnacipran","Mirtazapin",
+     "Moclobemid","Opipramol","Paroxetin","Sertralin","Tianeptin",
+     "Tranylcypromin","Trazodon","Trimipramin","Venlafaxin")

sleepmed_names <- c(
+     "Amitriptylin","Baldrianwurzel","Baldrianwurzel, Kombinationen","Clonazepam",
+     "Daridorexant","Diazepam","Doxepin","Eszopiclon","Lavendelöl","Levomepromazin",
+     "Lorazepam","Loxapin","Melatonin","Melperon","Mirtazapin","Pipamperon",
+     "Promethazin","Prothipendyl","Quetiapin","Temazepam","Trazodon",
+     "Zolpidem","Zopiclon

patcodedclas <- patcoded %>%
+     mutate(
+         .med_norm = toupper(str_squish(as.character(med_name))),
+         is_antidepressiva = .med_norm %in% toupper(antidep_names),
+         is_sleepmed       = .med_norm %in% toupper(sleepmed_names),
+         antidepressiva_yn = if_else(is_antidepressiva, "Yes", "No"),
+         sleepmed_yn       = if_else(is_sleepmed,       "Yes", "No"),
+         any_category_yn   = if_else(is_antidepressiva | is_sleepmed, "Yes", "No")
+     ) %>%
+     select(-.med_norm)

4. Filter based on baseline + combine 
baseline <- patcodedclas |>
+ filter(.data[["studyeventoid"]] == "e.mzp1")


baseline_comb <- baseline |>
  group_by(supplementalid) |>
  summarise(
    meds = med_name |> unique() |> sort() |> str_c(collapse = "; "),
    any_antidepressiva = any(is_antidepressiva, na.rm = TRUE),
    any_sleepmed = any(is_sleepmed, na.rm = TRUE),
    .groups = "drop"
  )
write_xlsx(baseline_comb,
+            path = "D:/SDD/4_Forschungszentrum/P4D/6 - Data Export Set.xlsx")
