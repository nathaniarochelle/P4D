# Clean Data --> all NA omitted
corr_all_clean0526 <- corr_all0526 %>%
+     dplyr::select(
+         hamd24_baseline,
+         wrss_baseline,
+         age,
+         gender
+     ) %>%
+     na.omit()

# Partial Spearman Correlation -> control for age and gender

library(ppcor)
> 
> pcor.test(
+     x = corr_all_clean0526$hamd24_baseline,
+     y = corr_all_clean0526$wrss_baseline,
+     z = as.matrix(corr_clean[, c("age", "gender")]),
+     method = "spearman"
+ )

# Plot 
library(ggplot2)

ggplot(
  corr_all_clean0526,
  aes(x = hamd24_baseline, y = wrss_baseline)
) +
  geom_point(
    color = "#343981",
    alpha = 0.7,
    size = 3
  ) +
  geom_smooth(
    method = "lm",
    formula = y ~ x,
    color = "red",
    fill = "#F4A6A6",   # light red confidence band
    linewidth = 2,
    se = TRUE
  ) +
  annotate(
    "label",
    x = Inf,
    y = -Inf,
    label = "Partial Spearman rho = 0.32\np < .001",
    hjust = 1.05,
    vjust = -0.5,
    size = 4.5,
    label.size = 0.3
  ) +
  labs(
    title = "Association between HDRS-24 and AWRS",
    subtitle = "Partial Spearman correlation adjusted for age and gender",
    x = "HDRS-24 Baseline",
    y = "AWRS Baseline"
  ) +
  theme_classic(base_size = 14) +
  theme(
    plot.title = element_text(face = "bold"),
    plot.subtitle = element_text(color = "grey40"),
    axis.title = element_text(face = "bold")
  )
