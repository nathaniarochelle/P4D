1. HAMD-24 and AWRS at Baseline 

# Join Data 
library(tidyr)
> library(dplyr)
> 
> corr_all0526 <- hamd_diff0526 %>%
+     
+     # Join WRSS data
+     left_join(wrss_diff0526, by = "supplementalid") %>%
+     
+     # Join anam data (select + rename in one step)
+     left_join(
