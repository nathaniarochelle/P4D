1) Defining columns, missing values + Calculating Total Score

library(dplyr)
library(tidyr)

hamd_scored <- hamd %>%
  mutate(
    across(
      all_of(item_cols),
      ~ suppressWarnings(as.numeric(.))
    ),
    hamd_18a = replace_na(hamd_18a, 0),
    hamd24_score = rowSums(
      pick(all_of(item_cols)),
      na.rm = treat_other_na_as_zero
    )
  )

2) Calculating Delta 

Follow up point: last point available

hamd_diff <- hamd_scored %>%
  filter(studyeventoid %in% c("e.mzp1", "e.mzp3", "e.mzp4",
                              "e.mzp5", "e.mzp6", "e.mzp7")) %>%
  mutate(
    tp_order = case_when(
      studyeventoid == "e.mzp1" ~ 1,
      studyeventoid == "e.mzp3" ~ 3,
      studyeventoid == "e.mzp4" ~ 4,
      studyeventoid == "e.mzp5" ~ 5,
      studyeventoid == "e.mzp6" ~ 6,
      studyeventoid == "e.mzp7" ~ 7
    )
  ) %>%
  group_by(supplementalid) %>%
  summarise(
    hamd24_baseline = first(hamd24_score[studyeventoid == "e.mzp1"]),
    hamd24_followup = if(any(tp_order > 1))
      hamd24_score[which.max(tp_order)]
    else
      NA_real_,
    followup_event = if(any(tp_order > 1))
      studyeventoid[which.max(tp_order)]
    else
      NA_character_,
    .groups = "drop"
  ) %>%
  mutate(
    hamd24_diff = hamd24_followup - hamd24_baseline,
    missing_baseline = is.na(hamd24_baseline),
    missing_followup = is.na(hamd24_followup),
    two_points_available = !(missing_baseline | missing_followup)
  )


