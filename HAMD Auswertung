1) Defining columns and  missng value

library(dplyr)
library(tidyr)

score_hamd <- function(hamd,
                       id_col = "supplementalid",
                       tp_col = "studyeventoid",
                       treat_other_na_as_zero = FALSE,
                       validate_ranges = TRUE,
                       item_min = 0,
                       item_max = 4) {
  if (!is.data.frame(hamd)) stop("`hamd` must be a data.frame or tibble.")
  if (!id_col %in% names(hamd)) stop("`id_col` not found: ", id_col)
  if (!tp_col %in% names(hamd)) stop("`tp_col` not found: ", tp_col)

  hamd_scored <- hamd

  # 1) Items: hamd_01..hamd_24 + hamd_18a/18b
  item_cols <- grep("^hamd_\\d{2}$|^hamd_18a$|^hamd_18b$", names(hamd_scored), value = TRUE)
  if (length(item_cols) == 0) {
    stop("No HAMD item columns found. Expect hamd_01..hamd_24 (+ hamd_18a/hamd_18b).")
  }

  # 2) Coerce to numeric
  for (cn in item_cols) {
    hamd_scored[[cn]] <- suppressWarnings(as.numeric(hamd_scored[[cn]]))
  }

  # 3) Special rule: hamd_18a NA -> 0
  if ("hamd_18a" %in% names(hamd_scored)) {
    hamd_scored[["hamd_18a"]] <- ifelse(is.na(hamd_scored[["hamd_18a"]]), 0, hamd_scored[["hamd_18a"]])
  }

2) Calculating Total Score

  if (isTRUE(treat_other_na_as_zero)) {
    hamd_scored <- hamd_scored |>
      rowwise() |>
      mutate(hamd24_score = sum(c_across(all_of(item_cols)), na.rm = TRUE)) |>
      ungroup()
  } else {
    hamd_scored <- hamd_scored |>
      rowwise() |>
      mutate(hamd24_score = sum(c_across(all_of(item_cols)), na.rm = FALSE)) |>
      ungroup()
  }

  hamd_scored
}

3) Calculating Delta 

hamd_diff <- hamd_scored %>%
+     
+     # Keep all relevant timepoints
+     filter(studyeventoid %in% c("e.mzp1", "e.mzp3", "e.mzp4", "e.mzp5", "e.mzp6", "e.mzp7")) %>%
+     
+     # Order timepoints so the "latest" follow-up can be selected
+     mutate(
+         tp_order = case_when(
+             studyeventoid == "e.mzp1" ~ 1,
+             studyeventoid == "e.mzp3" ~ 3,
+             studyeventoid == "e.mzp4" ~ 4,
+             studyeventoid == "e.mzp5" ~ 5,
+             studyeventoid == "e.mzp6" ~ 6,
+             studyeventoid == "e.mzp7" ~ 7
+         )
+     ) %>%
+     
+     # Pick baseline (always e.mzp1) and latest follow‑up
+     group_by(supplementalid) %>%
+     summarize(
+         hamd24_baseline = hamd24_score[studyeventoid == "e.mzp1"][1],
+         # latest follow-up = maximum tp_order greater than baseline
+         hamd24_followup = hamd24_score[tp_order == max(tp_order[tp_order > 1])],
+         followup_event = studyeventoid[tp_order == max(tp_order[tp_order > 1])],
+         .groups = "drop"
+     ) %>%
+     
+     mutate(
+         hamd24_diff = hamd24_followup - hamd24_baseline,
+         missing_baseline = is.na(hamd24_baseline),
+         missing_followup = is.na(hamd24_followup),
+         two_points_available = !(missing_baseline | missing_followup)
+     )

